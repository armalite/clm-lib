# Names only. clm-lib never reads this file; export variables in your shell if needed.
# The Anthropic SDK resolves credentials itself: ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN,
# or an `ant auth login` profile (optionally selected with ANTHROPIC_PROFILE).
ANTHROPIC_API_KEY=
# ANTHROPIC_PROFILE=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
